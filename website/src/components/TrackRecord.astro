---
import type { TrackItem } from '../lib/track-record.ts';
interface Legacy { call: string; outcome: 'hit' | 'miss' | 'open' | 'cancelled'; prior_p: number }
interface Props {
  label?: string;
  /** TrackItem from the persistent ledger; a bare row on a non-dated page. */
  items: Array<TrackItem | Legacy>;
  /** The paper's settled calls to date, across every edition. */
  record?: { hit: number; miss: number };
}
const { label = 'Resolved · Last Edition', items, record } = Astro.props;
const settled = (record?.hit ?? 0) + (record?.miss ?? 0);
const mark = (r: TrackItem | Legacy) => {
  const state = 'state' in r ? r.state : r.outcome;
  if (state === 'hit') return '✓ settled hit';
  if (state === 'miss') return '✗ settled miss';
  if (state === 'cancelled') return '⊘ cancelled';
  if (state === 'due') return '! due — awaiting verification';
  if (state === 'pending') return `… not yet due${'deadline' in r && r.deadline ? ` · ${r.deadline}` : ''}`;
  return '… open';
};
---
<div class="track-record-block">
  <div class="resolved-label">{label}</div>
  <div class="track-record">
    {settled > 0 && (
      <span class="tally">Record to date · {record!.hit} hit · {record!.miss} miss</span>
    )}
    {items.length === 0 ? (
      settled > 0
        ? <span class="genesis">No call settled at this bell and none is open.</span>
        : <span class="genesis">The ledger opens today — the desk's first calls resolve at the next bell. No record to demote yet.</span>
    ) : items.map((r) => (
      <span class="mono">
        {r.call} <span class={'state' in r ? r.state : r.outcome}>
          {mark(r)} (p={r.prior_p.toFixed(2)})
        </span>
        {'note' in r && r.note && <span class="note">Ledger{r.noted ? `, ${r.noted}` : ''}: {r.note}</span>}
      </span>
    ))}
  </div>
</div>

<style>
  .resolved-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 10px 0 6px;
    margin-top: 18px;
    margin-bottom: 0;
  }
  .track-record {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    padding: 14px 18px 18px;
    background: var(--paper-shade);
  }
  .track-record .hit  { color: var(--ink-soft); }
  .track-record .miss { color: var(--ink-soft); text-decoration: line-through; text-decoration-color: var(--red); }
  .track-record .open,
  .track-record .pending { color: var(--muted); opacity: 0.7; }
  .track-record .due { color: var(--accent); font-weight: 700; }
  .track-record .cancelled { color: var(--muted); text-decoration: line-through; }
  .track-record .note { display: block; margin-top: 3px; font-family: var(--font-serif); font-style: italic; font-size: 12px; color: var(--ink-soft); }
  .track-record .mono { font-family: var(--font-mono); letter-spacing: 0; text-transform: none; font-size: 10.5px; }
  .track-record .tally { color: var(--ink-soft); }
  .track-record .genesis { font-family: var(--font-serif); font-style: italic; letter-spacing: 0; text-transform: none; font-size: 12.5px; color: var(--ink-soft); }
</style>
