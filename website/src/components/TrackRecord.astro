---
import type { TrackItem } from '../lib/track-record.ts';
interface Legacy { call: string; outcome: 'hit' | 'miss' | 'open' | 'cancelled'; prior_p: number }
interface Props {
  label?: string;
  /** TrackItem from the persistent ledger; a bare row on a non-dated page. */
  items: Array<TrackItem | Legacy>;
  /** The paper's settled calls to date, across every edition. */
  record?: { hit: number; miss: number };
}
const { label: title = 'Resolved · Last Edition', items, record } = Astro.props;
const settled = (record?.hit ?? 0) + (record?.miss ?? 0);
// Open calls already sit in the Forecast Ledger above; this block is the record:
// only what settled (or was cancelled) at this bell.
const isSettled = (r: TrackItem | Legacy) => ['hit', 'miss', 'cancelled'].includes('state' in r ? r.state : r.outcome);
const rows = items.filter(isSettled);
// The Forecast Ledger's row pattern: state | call (+ Ledger's note) | prior.
const stateOf = (r: TrackItem | Legacy) => ('state' in r ? r.state : r.outcome);
const label = (r: TrackItem | Legacy) => {
  const state = stateOf(r);
  if (state === 'hit') return 'Settled · hit';
  if (state === 'miss') return 'Settled · miss';
  if (state === 'cancelled') return 'Cancelled';
  if (state === 'due') return 'Due · checking';
  if (state === 'pending') return 'Not yet due';
  return 'Open';
};
---
<div class="tr">
  <div class="tr-head">
    <span class="tr-label">{title}</span>
    {settled > 0 && <span class="tr-meta">Record to date · {record!.hit} hit · {record!.miss} miss</span>}
  </div>
  {rows.length === 0 ? (
    <p class="tr-genesis">{settled > 0
      ? 'No call settled at this bell.'
      : 'The ledger opens today — the desk’s first calls resolve at the next bell. No record to demote yet.'}</p>
  ) : (
    <div class="tr-rows">
      {rows.map((r) => (
        <div class="tr-row">
          <span class="tr-scol">
            <span class={`tr-state ${stateOf(r)}`}>{label(r)}</span>
            {stateOf(r) === 'pending' && 'deadline' in r && r.deadline && <span class="tr-when">{r.deadline}</span>}
          </span>
          <div class="tr-qcol">
            <span class="tr-q">{r.call}</span>
            {'note' in r && r.note && <span class="tr-note">Ledger{r.noted ? `, ${r.noted}` : ''}: {r.note}</span>}
          </div>
          <span class="tr-p">{r.prior_p.toFixed(2)}</span>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  /* The Forecast Ledger's table pattern (ForecastLedger.astro), one rule above. */
  .tr { margin: 28px 0; padding: 14px 0 10px; border-top: 1px solid var(--hairline-strong); }
  .tr-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    font-family: var(--font-sans); text-transform: uppercase; letter-spacing: 0.16em; font-size: 11px;
    padding-bottom: 10px; border-bottom: 1px solid var(--hairline-strong);
  }
  .tr-label { font-weight: 700; color: var(--ink); }
  .tr-meta { color: var(--muted); font-size: 10px; }
  .tr-rows { display: flex; flex-direction: column; }
  .tr-row {
    /* State and call on the ledger's first two tracks; the probability flush right. */
    display: grid; grid-template-columns: 110px 1fr 64px; gap: 16px; align-items: start;
    padding: 12px 0; border-bottom: 1px dotted var(--hairline);
  }
  .tr-row:last-child { border-bottom: none; }
  .tr-scol { display: flex; flex-direction: column; gap: 3px; padding-top: 3px; }
  .tr-when { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--muted); text-transform: uppercase; }
  .tr-state {
    font-family: var(--font-sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--muted);
  }
  .tr-state.due { color: var(--accent); }
  .tr-state.hit { color: var(--green); }
  .tr-state.miss { color: var(--red); }
  .tr-qcol { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .tr-q { font-family: var(--font-body); font-size: 14.5px; line-height: 1.4; color: var(--ink); }
  .tr-note {
    font-family: var(--font-body); font-size: 12.5px; line-height: 1.4; color: var(--ink-soft);
    border-left: 2px solid var(--accent); padding-left: 8px;
  }
  .tr-p { font-family: var(--font-mono); font-size: 13px; font-weight: 500; color: var(--accent); text-align: right; font-variant-numeric: tabular-nums; }
  .tr-genesis { font-family: var(--font-body); font-style: italic; font-size: 13px; color: var(--ink-soft); margin: 12px 0 0; }
  @media (max-width: 880px) {
    .tr-row { grid-template-columns: 1fr auto; }
    .tr-scol { grid-column: 1 / -1; flex-direction: row; gap: 8px; padding-top: 0; }
    .tr-p { grid-column: 2; }
  }
</style>
