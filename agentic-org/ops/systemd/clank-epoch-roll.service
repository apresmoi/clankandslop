# All that is left of the daily deploy: roll the wake budget, recreate the
# container on THE SAME IMAGE. No repin, no bundle, no build, no new image.
#
# WHY THIS STILL EXISTS, AND WHAT DELETES IT
# ------------------------------------------
# It should not have to. The target state is no daily container churn at all,
# and this unit is the one step that could not get there, for a reason in
# Daimon rather than here. Read this before concluding the work was left half
# done:
#
#   * `DAIMON_WAKE_FUSE_EPOCH` names the counting window, and the container
#     reads it from `up --env-file`, which applies at container CREATION only.
#   * Daimon's `WakeFuse.open()` loads the epoch's admissions into an IN-MEMORY
#     Set, and both `snapshot()` and `admitNow()` read `this.admissions.size`.
#     Nothing re-reads the ledger while the process lives, so the budget cannot
#     be reset from the host either — rotating `admissions.jsonl` under a
#     running container changes nothing.
#
# So the window can only turn over by restarting the process, and it can only
# turn over UNDER A NEW NAME by recreating the container. Daimon PR #32 claims
# to fix this and does not: its roll is called only from `admitNow`, while the
# live scheduled-wake path returns at the `snapshot()` gate in
# `AttentionDispatcher.drain()` before `admit` is ever reached, so a newsroom
# that has hit its ceiling stays wedged. The real fix is to re-evaluate the
# window where it is CONSULTED, not only where it is spent. When that lands,
# delete this unit.
#
# IT DEGRADES, IT DOES NOT FAIL THE DAY
# -------------------------------------
# `gate` runs first, so an in-flight wake is never killed; a refusal means the
# newsroom keeps yesterday's budget window and keeps running, which is survivable
# for a day and is reported as such. `spawnfile up` keeps the old container until
# the candidate is healthy, so a bad recreate rolls back by itself. And because
# the corpus is no longer in the image, a failed recreate no longer costs the
# day's research — which is the whole point of the change this unit belongs to.
[Unit]
Description=Roll the newsroom wake-budget epoch and recreate the container
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
OnFailure=clank-alarm@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/work/clankandslop
EnvironmentFile=-/etc/clank-alarm/alarm.env
# The effective environment of the old clank-seam.service, flattened. That unit
# accumulated five drop-ins, one of which existed only to reset the other four;
# a job that needs a comment to explain which of its own variables are live is a
# job nobody can reason about. This is the surviving set, inline.
Environment=PATH=/home/clank/deploy-work/node24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SPAWNFILE_ALLOW_LOCAL_E2E=1
Environment=SPAWNFILE_LOCAL_MOLTNET_RELEASE_DIR=/root/work/moltnet/dist/spawnfile-local-release
Environment=SPAWNFILE_DAIMON_LOCAL_RUNTIME_IDENTITY=/home/clank/deploy-work/grok-runtime-identity-20260922.json
Environment=SPAWNFILE_CLI=/home/clank/deploy-work/spawnfile-main/dist/cli/index.js
# The same lock the corpus refresher takes, so a recreate can never read the
# volume while a tree is being renamed into or out of it: the Daimon root
# ownership guard walks the whole volume at start and aborts the start if an
# entry it listed then cannot be stat'd.
ExecStart=/usr/bin/flock /run/lock/clank-corpus-refresh.lock /home/clank/deploy-work/node24/bin/node /root/work/clankandslop/agentic-org/scripts/epoch-roll-run.mjs
TimeoutStartSec=1800
