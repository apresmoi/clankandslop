# The OnFailure= handler. %i is the unit that failed.
#
# IT RECORDS LOCALLY AND SENDS NOTHING. The previous revision ran alarm.mjs,
# which POSTed the alarm to a public ntfy.sh topic held in
# /etc/clank-alarm/alarm.env. Both are retired: the alarm text names the box,
# the failed unit and its exit status, and no third party needs to see any of
# it. What replaces the channel is a local record, so there is somewhere to
# look. See clank-alarm.sh for what is written and why.
#
# IT POINTS AT A STANDALONE COPY, NOT AT THE CHECKOUT. Verified the hard way on
# 2026-09-06: pointed into /root/work/clankandslop, the handler died with
# MODULE_NOT_FOUND because that tree had not been updated yet. An alarm that
# only works when the repository is in the right state is missing exactly when
# the repository is the problem. clank-alarm.sh needs nothing but /bin/sh,
# coreutils and util-linux.
#
# These are SYSTEM units, not the user units the 4090 runs, so the script is
# invoked with CLANK_ALARM_SCOPE=--system; the file is otherwise the merged
# sensors/automation/clank-alarm.sh from clankandslop-private.
#
# Prove it before trusting it:
#   systemctl start clank-alarm@some-unit.service
#   tail -5 /var/lib/clank-alarm/alarm.log
#   journalctl -t clank-alarm -n 5
[Unit]
Description=Record the newsroom alarm for %i

[Service]
Type=oneshot
Environment=CLANK_ALARM_SCOPE=--system
StateDirectory=clank-alarm
ExecStart=/usr/local/lib/clank-alarm/clank-alarm.sh %i
