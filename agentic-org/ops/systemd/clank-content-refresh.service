# Keep every PUBLISHED edition visible to the newsroom WITHOUT building an image.
#
# WHAT IT REPLACES
# ----------------
# The nightly rebuild. Published editions used to ride inside
# newsroom-runtime.tar, so every edition repinned all twelve Spawnfiles, moved
# origin/main in an image input, and clank-release.timer rebuilt and redeployed
# the organization every night for a change that was data. The editions and
# their byline indexes are now the `clank-newsroom-content` volume, and this unit
# lands them from origin/main -- the same discipline as
# clank-corpus-refresh.service, through the same primitives.
#
# IT USES THE RELEASE JOB'S CHECKOUT AND KEY, AND NOTHING NEW
# -----------------------------------------------------------
# It reads refs in /root/work/clankandslop -- the build root clank-release.service
# already fetches -- and never touches its working tree, so the release job's
# fast-forward is unaffected. The fetch needs the same explicit identity the
# release job names (the public remote has no SSH host alias), hence the same
# CLANK_RELEASE_FETCH_KEY line. An unreachable remote keeps the last good content
# mounted and exits 0; a refused key fails and pages.
#
# ONE WRITER, AND THE SAME LOCK
# -----------------------------
# The script re-executes itself under flock(1) on
# /run/lock/clank-corpus-refresh.lock -- the lock clank-corpus-refresh.service and
# clank-release.service already take -- so a refresh never interleaves with a
# container recreate, whose startup guard walks every volume. A busy lock is
# "nothing to do", exit 0; the next poll lands it.
#
# WHAT OnFailure= COVERS
# ----------------------
# A refresh that could not be done at all: a refused identity, an unreadable
# checkout, content git does not vouch for (the last good editions stay mounted
# and content-refresh-failed is raised by the script itself). Tampering is
# reported through clank-alarm's content-tampered word and repaired from git,
# bounded by --heal-limit; an unchanged operator-only state pages once, not every
# poll.
[Unit]
Description=Refresh the newsroom's published-content volume from public main
After=network-online.target docker.service
Wants=network-online.target
OnFailure=clank-alarm@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/work/clankandslop
Environment=PATH=/home/clank/deploy-work/node24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CLANK_RELEASE_FETCH_KEY=/root/.ssh/clank_public
ExecStart=/home/clank/deploy-work/node24/bin/node /root/work/clankandslop/agentic-org/scripts/content-refresh.mjs
TimeoutStartSec=600
