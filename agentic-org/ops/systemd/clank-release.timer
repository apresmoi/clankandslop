# Hourly. `spawnfile release` decides whether there is anything to do (an
# unchanged image identity is a no-op) and drains running turns instead of
# waiting for a quiet hour. A drain that times out is a deferral (exit 75),
# retried next hour and reported once after a day, never an hourly page.
[Unit]
Description=Check hourly whether the organization needs releasing

[Timer]
OnCalendar=*-*-* *:05:00 Europe/Berlin
Persistent=false
Unit=clank-release.service

[Install]
WantedBy=timers.target
