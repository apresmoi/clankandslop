# Hourly. The release itself decides whether there is anything to do, and
# declines without paging when the newsroom is awake — a job that pages on a
# closed window twenty times a day teaches the operator to ignore the pager,
# which is how the 2026-09-23 deploy failure reached nobody.
[Unit]
Description=Check hourly whether the organization needs releasing

[Timer]
OnCalendar=*-*-* *:05:00 Europe/Berlin
Persistent=false
Unit=clank-release.service

[Install]
WantedBy=timers.target
