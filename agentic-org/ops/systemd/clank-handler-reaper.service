# Reap leaked Daimon engine-broker handlers. The org is never restarted daily any
# more, so handlers a Daimon bug leaves spinning accumulate until load starves
# every turn (2026-10-02: 58 of them, load 60 on 2 CPUs). The script only kills
# bare handler processes older than any possible turn; its age floor is pinned
# above the Spawnfiles' longest turn_limits.timeout_ms by systemd-contract.test,
# because at 1200s it killed live 20-30 minute writer turns on 2026-10-04.
#
# Runs from the release checkout, so a merged change reaches the host with the
# next release and never needs a hand copy.
[Unit]
Description=Kill leaked Daimon engine handlers older than any possible turn
OnFailure=clank-alarm@%n.service

[Service]
Type=oneshot
ExecStart=/bin/bash /root/work/clankandslop/agentic-org/ops/bin/clank-handler-reaper.sh
TimeoutStartSec=60
