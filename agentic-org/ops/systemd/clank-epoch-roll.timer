# 11:00 Europe/Berlin — the slot clank-seam.timer vacated, and for the same
# derived reason: the earliest declared wake in the tree is 13:00 Berlin
# (agents/*/Spawnfile) and a recreate kills an in-flight wake, so this runs two
# hours ahead of the newsroom. It no longer has to be early enough for a 5GB
# image build, because there is no longer a build.
#
# The job recomputes the safe window from the Spawnfiles on every run and
# declines if this hour has stopped being safe, so moving the crons cannot
# silently make this timer wrong — it makes the job decline and say so.
[Unit]
Description=Roll the newsroom wake budget before the reporters wake

[Timer]
OnCalendar=*-*-* 11:00:00 Europe/Berlin
Persistent=false
Unit=clank-epoch-roll.service

[Install]
WantedBy=timers.target
