# Every five minutes, all day.
#
# Published content changes at most once a day (an edition merge, ~18:00 Berlin),
# so five minutes is not about freshness; it is the tamper window. Every run that
# finds nothing to land re-verifies the served tree against the host's manifest
# and git and repairs drift, so an edit to the shared, agent-writable mount
# survives at most one interval. The no-op path is one fetch, three rev-parses,
# one small JSON read and one lstat walk.
[Unit]
Description=Keep the newsroom's published-content volume current

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=15s
Persistent=false
Unit=clank-content-refresh.service

[Install]
WantedBy=timers.target
