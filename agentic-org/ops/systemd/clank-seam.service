# The seam: repin the private corpus to today's edition branch, rebuild the
# bundles, rebuild the image, redeploy — the step that used to be a person.
#
# The job refuses to deploy unless the schedule is clear AND the running
# container is quiet (see agentic-org/scripts/wake-window.mjs), so an overrun
# wake or a manual one is enough to stop it; the timer's hour is a convenience,
# not the safety property.
[Unit]
Description=Clank newsroom seam (repin, bundle, build, deploy)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# systemd's own Failed is what screamed into a void for two days. This is the
# void being replaced: any exit that systemd calls a failure raises the alarm.
OnFailure=clank-alarm@%n.service

[Service]
Type=oneshot
WorkingDirectory=/root/work/clankandslop
# Verified by running the seam end to end on the box, 2026-09-06.
# SPAWNFILE_LOCAL_MOLTNET_RELEASE_DIR, not SPAWNFILE_MOLTNET_RELEASE_DIR: the
# published-release path wants moltnet_release_stamp_<arch>.json, and what the
# box has is the LOCAL release, stamped local_moltnet_release_stamp_<arch>.json.
# Pointing the published variable at the local directory fails the capability
# stamp check — which is the compiler refusing an unstamped release correctly,
# not a bug to route around. SPAWNFILE_ALLOW_LOCAL_E2E=1 is what admits it.
Environment=SPAWNFILE_MOLTNET_TARGET_ARCH=amd64
Environment=SPAWNFILE_CLI=/home/clank/deploy-work/spawnfile-main/dist/cli/index.js
Environment=PATH=/home/clank/deploy-work/node24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=SPAWNFILE_DAIMON_SOURCE_DIR=/root/work/daimon
Environment=SPAWNFILE_DAIMON_PACKAGE_TARBALL=/root/work/noopolis-daimon-0.2.0.tgz
Environment=SPAWNFILE_DAIMON_LOCAL_RUNTIME_IDENTITY=/root/work/spawnfile/.local-daimon-runtime-identity.json
Environment=SPAWNFILE_LOCAL_MOLTNET_RELEASE_DIR=/root/work/moltnet/dist/spawnfile-local-release
Environment=SPAWNFILE_ALLOW_LOCAL_E2E=1
ExecStart=/home/clank/deploy-work/node24/bin/node /root/work/clankandslop/agentic-org/scripts/seam-run.mjs
TimeoutStartSec=3600
