{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clankandslop.example/schemas/receipt/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "kind", "edition", "owner", "created_at", "status", "inputs", "digest"],
  "properties": { "version": { "const": "v1" }, "kind": { "enum": ["filing", "review", "release", "settlement"] }, "edition": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "owner": { "type": "string" }, "created_at": { "type": "string", "format": "date-time" }, "status": { "enum": ["accepted", "rejected", "handoff"] }, "inputs": { "type": "array", "items": { "type": "string" } }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
