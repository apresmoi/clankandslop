{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clankandslop.example/schemas/browser-broker/v1",
  "oneOf": [
    { "title": "request", "type": "object", "additionalProperties": false, "required": ["version", "request_id", "purpose", "edition", "urls"], "properties": { "version": { "const": "v1" }, "request_id": { "type": "string" }, "purpose": { "enum": ["primary_source", "attribution_check", "countercase", "forecast_discriminator"] }, "edition": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } } } },
    { "title": "result", "type": "object", "additionalProperties": false, "required": ["version", "request_id", "health", "sources"], "properties": { "version": { "const": "v1" }, "request_id": { "type": "string" }, "health": { "enum": ["ok", "degraded", "unavailable"] }, "sources": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["url", "retrieved_at", "capture_digest", "private_locator"], "properties": { "url": { "type": "string", "format": "uri" }, "retrieved_at": { "type": "string", "format": "date-time" }, "capture_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "private_locator": { "type": "string", "pattern": "^private:" } } } } } }
  ]
}
