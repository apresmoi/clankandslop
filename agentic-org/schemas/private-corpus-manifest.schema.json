{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clankandslop.example/schemas/private-corpus-manifest/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "edition", "root", "artifacts"],
  "properties": {
    "version": { "const": "v1" }, "edition": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "root": { "type": "string", "pattern": "^/" },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "owner", "digest"], "properties": { "kind": { "enum": ["sensor-ledger", "candidates", "evidence", "pinpoint", "dossiers", "compose", "decisions", "receipts"] }, "path": { "type": "string", "pattern": "^(sensor-ledger|candidates|evidence|pinpoint|dossiers|compose|decisions|receipts)/[a-z0-9._/-]+$" }, "owner": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } } }
  }
}
