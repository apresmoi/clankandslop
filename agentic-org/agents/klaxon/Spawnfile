spawnfile_version: "0.1"
kind: agent
name: klaxon
runtime:
  name: daimon
  options:
    engine: codex
    codex_policy: workspace-no-network
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: klaxon }
      dms: { enabled: true, wake: all, allowed_wake_senders: [research-sensor] }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: klaxon, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/tools/newsroom/state/transaction.mjs, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:klaxon" }
      tools: [qualify_signal]
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:b568c26d02ca4e6f1b1e4b020afcac4b4558b8863b0bc69f2ebd8b8574266785, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:a8713039b5eeef5b91349c98b41dd791e52127ef7628ffe7cb2b7e14b558ad3a, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:1b9d4fad435d6263eb31d80f3685eee3ce5805841d308757ec32b0155b71048e, mount: ./repos/newsroom-private, mode: readonly }
    - { id: private-corpus, kind: volume, name: clank-klaxon-corpus, mount: ./private/corpus, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-klaxon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
