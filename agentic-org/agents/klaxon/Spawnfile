spawnfile_version: "0.1"
kind: agent
name: klaxon
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 20
      max_tokens: 3000000
    turn_limits:
      max_tokens: 1100000
      timeout_ms: 900000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: medium
  sandbox:
    mode: workspace
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: klaxon }
      dms: { enabled: true, wake: all, allowed_wake_senders: [research-sensor] }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: klaxon, CLANK_PUBLIC_CONTENT_VOLUME: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/repos/newsroom-content, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/tools/newsroom/state/transaction.mjs, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:klaxon" }
      tools: [qualify_signal]
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:484748db3a8e990462b01e82cd7f265eba5c1152d7f055fe92b4de646c797e53, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:56d27c3b1b3caf8764b68d565a027e4063d7e4ee1459f762d6831cf25d407be8, mount: ./repos/newsroom, mode: readonly }
    - { id: private-corpus, kind: volume, name: clank-klaxon-corpus, mount: ./private/corpus, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-klaxon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
