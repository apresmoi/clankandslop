spawnfile_version: "0.1"
kind: agent
name: klaxon
runtime:
  name: daimon
  options:
    engine: grok
execution:
  sandbox:
    mode: workspace
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: klaxon }
      dms: { enabled: true, wake: all, allowed_wake_senders: [research-sensor] }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        sensor: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: klaxon, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/klaxon/state/edition }
      tools: [qualify_signal]
workspace:
  docs: { system: AGENTS.md }
  skills:
    - { ref: ../../skills/record-grounding }
    - { ref: ../../skills/newsroom-handoff }
    - { ref: ../../skills/repository-ownership }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:92ccafc3dc3c5709c179a2c16a0026124e71f0addfa09f9ef73f84502c74ba41, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:aea46e3296ca466bd419d3f73d54ff63f61096e854940653d609956393d04b8e, mount: ./repos/newsroom-private, mode: readonly }
    - { id: private-corpus, kind: volume, name: clank-klaxon-corpus, mount: ./private/corpus, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-klaxon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
