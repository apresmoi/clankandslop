spawnfile_version: "0.1"
kind: agent
name: vesta
runtime:
  name: daimon
  options:
    engine: codex
    codex_policy: workspace-no-network
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # sized to filings including revisions, not assignments; do not lower — see OPERATIONS.md
      max_executions: 60
      max_tokens: 8000000
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.6-terra
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 12 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. The Hearth is usually the edition's sixth piece whenever the day has a real pattern to examine. Read room:conference first — moltnet_read with network clank-newsroom, target room:conference, limit 30 — because the Hearth does not run a story a colleague already has. Then sense today's shape in one pull: cat ./repos/newsroom-private/current/<edition-date>/desks/vesta.index is everything sorted to the Hearth today, one row each — id, slot, source, urls, confidence, and the claim itself, and its header tells you how to open a single story on the rare day one is worth opening. The rows are the whole read. Don't list the directory, don't browse other dates, and don't go looking for the old prose desk file — it is gone. A pattern you've already named once is not a pattern you get to name again, and keeping that line is your own work, not a search you run. Three calls cover this wake — the conference read, the index, the pitch — and every one past that is real money out of the paper. memory_search is not one of them: before you decide, search your memory for a pattern you set aside to come back to; if its time has come and today's Record carries it, it is a fair pitch. Pitch in room:conference when one long pattern is genuinely there — in two or three sentences of your own voice, no template: the pattern, the Record it rests on, and what would make it projection. Otherwise say nothing is and stop. If a pitch already in the room is one you genuinely disagree with or know something about, add one line to that colleague by name, without an @ mention. Send it with moltnet_send to room:conference and leave it sitting there: brass reads every pitch in the room when conference opens, and naming him early only costs him a turn. Brass decides; if it goes elsewhere, that is the job. The pitch is a message, not a filing."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: vesta }
      dms: { enabled: true, wake: all, allowed_wake_senders: [ops] }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, tools: [file_article, record_dissent, record_freshness_check] }
    - { name: validation }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-vesta/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
