spawnfile_version: "0.1"
kind: agent
name: vesta
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 10 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. The Hearth runs roughly one edition in seven and defaults to spiked. Sense today's shape in one pull, not a folder to page through: cat ./repos/newsroom-private/<edition-date>/desks/vesta.md gets you everything sorted to the Hearth today, in a single call — don't list the directory first. Check what you've already woven the same way: rg -l Vesta ./repos/newsroom/content/editions/*/articles/*.json turns up every Hearth column and every dissent with your name on it, one call — a pattern you've already named once is not a pattern you get to name again. Two or three shell calls should cover this whole wake; every one past that is real money out of the paper. Pitch in room:assignment mentioning @brass only if one long pattern is genuinely there; otherwise say nothing is and stop. Send it with moltnet_send. The pitch is a message, not a filing."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: vesta }
      rooms:
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs], env: { CLANK_NEWSROOM_AGENT: vesta, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/state/edition }, tools: [file_article] }
workspace:
  docs: { system: AGENTS.md }
  skills:
    - { ref: ../../skills/article-composition }
    - { ref: ../../skills/record-grounding }
    - { ref: ../../skills/repository-ownership }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:f97871bbcebb0b7a3e434820d512fa7c0fcb5917768e3f5cfee3803c1d8e071c, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:34ab69f623f4592d3d33fe2e57dfc4e109a75f72bcb2c1c2e57f9838b76fab64, mount: ./repos/newsroom-private, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-vesta/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
