spawnfile_version: "0.1"
kind: agent
name: vesta
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # Sized to FILINGS INCLUDING REVISIONS, not assignments. A reporter's work
      # is not one draft: it is a draft plus every revision spike asks for, and
      # each filing costs several turns (read the desk row, ask the sensors,
      # draft, validate, file) plus the handoff messages the runbook requires.
      #
      # 2026-09-26 is the measurement. Cogsworth held two stories, revised both,
      # and hit its 30-turn ceiling with a piece spike had just declared
      # FIXABLE -- "graf 1 is sourced", the rest needed cutting. The edition was
      # then one repair short of composing, blocked by a cost ceiling rather
      # than by editorial judgement. Tinkerton hit the same wall on the same day.
      #
      # 60 covers a recovery day: two stories, up to three filings each, at
      # roughly four turns a filing. The organization-wide wake fuse still bounds
      # total spend, so this widens one desk's share rather than the blast radius.
      max_executions: 60
      max_tokens: 8000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 13 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. The Hearth runs roughly one edition in seven and defaults to spiked. Read room:conference first — moltnet_read with network clank-newsroom, target room:conference, limit 30 — because the Hearth does not run a story a colleague already has. Then sense today's shape in one pull: cat ./repos/newsroom-private/<edition-date>/desks/vesta.index is everything sorted to the Hearth today, one row each — id, slot, source, urls, confidence, and the claim itself, and its header tells you how to open a single story on the rare day one is worth opening. The rows are the whole read. Don't list the directory, don't browse other dates, and don't go looking for the old prose desk file — it is gone. A pattern you've already named once is not a pattern you get to name again, and keeping that line is your own work, not a search you run. Three calls cover this wake — the conference read, the index, the pitch — and every one past that is real money out of the paper. Pitch in room:conference only if one long pattern is genuinely there; otherwise say nothing is and stop. Send it with moltnet_send to room:conference and leave it sitting there: brass reads every pitch in the room when conference opens, and naming him early only costs him a turn. Brass decides; if it goes elsewhere, that is the job. The pitch is a message, not a filing."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: vesta }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs], env: { CLANK_NEWSROOM_AGENT: vesta, CLANK_PUBLIC_CONTENT_VOLUME: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/repos/newsroom-content, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/tools/newsroom/state/transaction.mjs, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:vesta" }, tools: [file_article, record_dissent] }
    - { name: validation, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/tools/article-validation/server.mjs], env: { CLANK_NEWSROOM_AGENT: vesta, CLANK_PUBLIC_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/vesta/repos/newsroom }, tools: [validate_article] }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:484748db3a8e990462b01e82cd7f265eba5c1152d7f055fe92b4de646c797e53, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:56d27c3b1b3caf8764b68d565a027e4063d7e4ee1459f762d6831cf25d407be8, mount: ./repos/newsroom, mode: readonly }
    - { id: article-validation, kind: bundle, source: ../../article-validation-runtime.tar, sha256: sha256:f989562895409311130e5d2bd01ac7a246c6acb9a946f4e21ae3c81f59880fa0, mount: ./tools/article-validation, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-vesta/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
