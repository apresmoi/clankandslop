spawnfile_version: "0.1"
kind: agent
name: cogsworth
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # sized to filings including revisions, not assignments; do not lower — see OPERATIONS.md
      max_executions: 60
      max_tokens: 8000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 12 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Read room:conference first — moltnet_read with network clank-newsroom, target room:conference, limit 30 — and if a colleague has already claimed your story, either pitch the angle they are not taking and say so, or go find something else. Then take the day in one pull: cat ./repos/newsroom-private/current/<edition-date>/desks/cogsworth.index is every story sorted to your hardware beat today, one row each — id, slot, source, urls, confidence, and the claim itself, and its header tells you how to open a single story if one turns out to be yours. The rows are the whole read: you pitch off the index and you do not open a story file to do it. Don't list the directory, don't browse other dates, and don't go looking for the old prose desk file — it is gone. A story you have chased already is worth more to you than a new one, and holding on to which those are is what makes this beat yours. Three calls cover this wake — the conference read, the index, the pitch — and every one past that is real money out of the paper. Pick at most ONE story worth the paper today and pitch it in room:conference — the claim, what a reader would understand from your piece that the main source does not say, why it matters now, and what would falsify it, in a few sentences of natural language. Send the pitch with moltnet_send to room:conference and leave it sitting there: brass reads every pitch in the room when conference opens, and naming him early only costs him a turn. Brass decides who runs what; if the story goes to someone else, that is the job, take the next one. The pitch is a message, not a filing: the article comes later."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: cogsworth }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, tools: [file_article, record_dissent, record_freshness_check] }
    - { name: validation }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-cogsworth/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
