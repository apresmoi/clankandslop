spawnfile_version: "0.1"
kind: agent
name: cogsworth
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # Sized to FILINGS INCLUDING REVISIONS, not assignments. A reporter's work
      # is not one draft: it is a draft plus every revision spike asks for, and
      # each filing costs several turns (read the desk row, ask the sensors,
      # draft, validate, file) plus the handoff messages the runbook requires.
      #
      # 2026-09-26 is the measurement. Cogsworth held two stories, revised both,
      # and hit its 30-turn ceiling with a piece spike had just declared
      # FIXABLE -- "graf 1 is sourced", the rest needed cutting. The edition was
      # then one repair short of composing, blocked by a cost ceiling rather
      # than by editorial judgement. Tinkerton hit the same wall on the same day.
      #
      # 60 covers a recovery day: two stories, up to three filings each, at
      # roughly four turns a filing. The organization-wide wake fuse still bounds
      # total spend, so this widens one desk's share rather than the blast radius.
      max_executions: 60
      max_tokens: 8000000
    turn_limits:
      max_tokens: 1100000
      timeout_ms: 900000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: low
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 13 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Read room:conference first — moltnet_read with network clank-newsroom, target room:conference, limit 30 — and if a colleague has already claimed your story, either pitch the angle they are not taking and say so, or go find something else. Then take the day in one pull: cat ./repos/newsroom-private/<edition-date>/desks/cogsworth.index is every story sorted to your hardware beat today, one row each — id, slot, source, urls, confidence, and the claim itself, and its header tells you how to open a single story if one turns out to be yours. The rows are the whole read: you pitch off the index and you do not open a story file to do it. Don't list the directory, don't browse other dates, and don't go looking for the old prose desk file — it is gone. A story you have chased already is worth more to you than a new one, and holding on to which those are is what makes this beat yours. Three calls cover this wake — the conference read, the index, the pitch — and every one past that is real money out of the paper. Pick at most ONE story worth the paper today and pitch it in room:conference — the claim, why it matters now, and what would falsify it, in a few sentences of natural language. Send the pitch with moltnet_send to room:conference and leave it sitting there: brass reads every pitch in the room when conference opens, and naming him early only costs him a turn. Brass decides who runs what; if the story goes to someone else, that is the job, take the next one. The pitch is a message, not a filing: the article comes later."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: cogsworth }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/cogsworth/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs], env: { CLANK_NEWSROOM_AGENT: cogsworth, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/cogsworth/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/cogsworth/tools/newsroom/state/transaction.mjs, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:cogsworth" }, tools: [file_article, record_dissent] }
    - { name: validation, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/cogsworth/tools/article-validation/server.mjs], env: { CLANK_NEWSROOM_AGENT: cogsworth, CLANK_PUBLIC_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/cogsworth/repos/newsroom }, tools: [validate_article] }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:beb200e68d9f59ca8b954b420dd42345f960ca5a6eb7d0261201182d5f1a17be, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:54a173242ae06bab94f6a8663f2754b4fcf4bfe194b050335cefa9925fa7aac8, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:87372076d7e07af5a30be8497bddfd438206b891acab4c64e5e8348835c6061d, mount: ./repos/newsroom-private, mode: readonly }
    - { id: article-validation, kind: bundle, source: ../../article-validation-runtime.tar, sha256: sha256:f989562895409311130e5d2bd01ac7a246c6acb9a946f4e21ae3c81f59880fa0, mount: ./tools/article-validation, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-cogsworth/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
