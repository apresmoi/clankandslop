spawnfile_version: "0.1"
kind: agent
name: foreman
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 10 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Read room:conference first — moltnet_read with network clank-newsroom, target room:conference, limit 30 — and if a colleague has already claimed your story, either pitch the angle they are not taking and say so, or go find something else. Then take the day in one pull: cat ./repos/newsroom-private/<edition-date>/desks/foreman.index is every story sorted to your macro beat today, one row each — id, slot, source, urls, confidence, and the claim itself, and its header tells you how to open a single story if one turns out to be yours. The rows are the whole read: you pitch off the index and you do not open a story file to do it. Don't list the directory, don't browse other dates, and don't go looking for the old prose desk file — it is gone. A story you have chased already is worth more to you than a new one, and holding on to which those are is what makes this beat yours. Three calls cover this wake — the conference read, the index, the pitch — and every one past that is real money out of the paper. Pick at most ONE story worth the paper today and pitch it in room:conference — the claim, why it matters now, and what would falsify it, in a few sentences of natural language. Send the pitch with moltnet_send to room:conference and leave it sitting there: brass reads every pitch in the room when conference opens, and naming him early only costs him a turn. Brass decides who runs what; if the story goes to someone else, that is the job, take the next one. The pitch is a message, not a filing: the article comes later."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: foreman }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, transport: stdio, command: /usr/local/bin/node, args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/foreman/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs], env: { CLANK_NEWSROOM_AGENT: foreman, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/foreman/state/edition }, tools: [file_article] }
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:5c8f234b6f2ba7f61e1a7f9d65115265d7932aa3f0d3d0d85b8f08e6dfaaae7e, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:aea46e3296ca466bd419d3f73d54ff63f61096e854940653d609956393d04b8e, mount: ./repos/newsroom-private, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-foreman/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
