spawnfile_version: "0.1"
kind: agent
name: ledger
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 20 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. Its P rows are today's PASSed articles and its D rows are the desk documents already on file. Two of those are yours, and the edition cannot be composed without them: ledger.settlements and ledger.worlddesk. Settlements is the resolution of what the paper said last time — open only the stories that carried a dated forecast, cat ./repos/newsroom/content/editions/<previous-edition-date>/articles/<id>.json one at a time, and record for each whether it came in, with the number and the recorded input that settles it. It is one object, {resolved_last_edition: [...]}, and nothing else. Each row carries three fields and only those three: call, the question in the words the paper published it in; outcome, exactly hit, miss or open; and prior_p, the posterior the paper carried into today, a number from 0 to 1. Those rows are the paper's own scorecard: Caslon prints them as the Track Record strip at the foot of the tape, and the calls still running become the tape's Open Clocks, so a settlement you leave out is a clock that silently stops. A forecast you cannot settle from an input already on the record is left unresolved and said to be unresolved: you never supply the conversion, the rate or the figure yourself, and an unverifiable calculation is a rejection, not an estimate. On a day when nothing settled, file resolved_last_edition as the empty array. Do not skip the document — four desk documents are what makes an edition, and three is no paper at all. Worlddesk is the same discipline applied to today, one object, {world_desk: {escalation_index, delta, open_conflicts, watch}}: escalation_index a number from 0 to 1, delta the one word for where it moved (steady, rising, easing), open_conflicts and watch plain counts. The front page prints all four in the masthead ear and again under the globe, with no guard around them, so a missing key is not a thinner page, it is a build that dies at 16:00. When today's inputs genuinely cannot move the index, carry yesterday's figure forward and put stale in delta so the page says so, rather than filing no document. File both with mcp_newsroom_file_desk using this schedule occurrence as event_key. The second of the two calls answers event_key conflict — the receipt for this wake was already written by the first — but your document has landed; do not file it again and do not read it as a failure. Caslon composes at 15:00 and reads what you filed; nothing else writes these two documents."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: ledger }
      rooms:
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: ledger, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/state/edition }
      tools: [file_desk]
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:d3fd5dcf55b246ef21a61e82b27496eb36f1781d8cc57e6358361aa48537ec6c, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:c78289d0e15683876b1f88cd573067e8a6558e976db3dd03278fa371ff8b188c, mount: ./repos/newsroom-private, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-ledger/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
