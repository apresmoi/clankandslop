spawnfile_version: "0.1"
kind: agent
name: ledger
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 20
      max_tokens: 4000000
    turn_limits:
      max_tokens: 1100000
      timeout_ms: 900000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 14 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Start at ./state/edition/editions/<edition-date>/INDEX. If Caslon has already composed this edition, do not refile; end the turn. Read repos/newsroom-private/current/<edition-date>/desks/ledger.settlements.prepared.json. Resolve calls only from recorded evidence; settle each due call, or give it a note on what you checked and why it is unresolved. If the corpus cannot settle every due call, send one combined research request for them as your instructions say, and file now with notes. Read the current derived document at repos/newsroom-private/current/<edition-date>/worlddesk/ledger.worlddesk.json and its trace.json; copy the document verbatim, markets included. If a refusal.json exists instead, follow the stale carry-forward rule in your instructions; never use ledger.worlddesk.prepared.json to invent current readings. File both documents with file_desk and the current wake id; both calls must succeed. Mention @caslon in room:release when ready."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: ledger }
      rooms:
        research: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, env: { CLANK_PUBLIC_SOURCE_ROOT: "${workspace}/repos/newsroom", CLANK_PRIVATE_SOURCE_ROOT: "${workspace}/repos/newsroom-private" }, tools: [file_desk] }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-ledger/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
