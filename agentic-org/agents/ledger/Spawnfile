spawnfile_version: "0.1"
kind: agent
name: ledger
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 20
      max_tokens: 4000000
    turn_limits:
      max_tokens: 1100000
      timeout_ms: 900000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: low
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 15 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Start at ./state/edition/editions/<edition-date>/INDEX and read repos/newsroom/agentic-org/agents/ledger/RUNBOOK.md. Read repos/newsroom-private/<edition-date>/desks/ledger.settlements.prepared.json. Resolve calls only from recorded evidence. Read the current derived document at repos/newsroom-private/<edition-date>/worlddesk/ledger.worlddesk.json and its trace.json; copy the document verbatim. If a refusal.json exists instead, follow the explicit stale carry-forward rule in your brief; never use ledger.worlddesk.prepared.json to invent current readings. File both documents with file_desk and the current wake id; both calls must succeed. Mention @caslon in room:release when ready."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: ledger }
      rooms:
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: ledger, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/tools/newsroom/state/transaction.mjs, CLANK_PUBLIC_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/repos/newsroom, CLANK_PRIVATE_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/ledger/repos/newsroom-private, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:ledger" }
      tools: [file_desk]
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:beb200e68d9f59ca8b954b420dd42345f960ca5a6eb7d0261201182d5f1a17be, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:d304c8cd60d7cdb0a0b82233bf3ea4de603dd92c3e1e0be361d8b9902dd0074c, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:87372076d7e07af5a30be8497bddfd438206b891acab4c64e5e8348835c6061d, mount: ./repos/newsroom-private, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-ledger/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
