spawnfile_version: "0.1"
kind: agent
name: spike
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # Sized to FILINGS, not assignments. Spike is the only agent whose work
      # scales with everyone else's output: six reporters revising means every
      # filing and every revision passes through this one reviewer, and each
      # verdict costs a turn plus the handoff message the runbook requires.
      #
      # 2026-09-26 is the measurement: 6 stories produced 14 filings and 13
      # verdicts, which consumed roughly 30 turns at about 2.1 turns per filing.
      # With 40 as the ceiling and ~10 turns already destroyed by a Mneme ledger
      # crash, spike hit agent_execution_ceiling with three stories still
      # unreviewed and the edition died at passed=3/5 — not on editorial
      # judgement, which is the only thing that should stop a paper.
      #
      # 100 covers a heavy revision day (~20 filings at 2.5 turns) with headroom.
      # The organization-wide fuse still bounds total spend, so this widens one
      # agent's share rather than the blast radius.
      max_executions: 100
      max_tokens: 12000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 13-16 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. Its F rows already carry the mechanical checks (word count, refs, source domains, topics, lint, citation order, persona leaks); take them as done and spend your reading on judgment. An index with no F rows means nothing has been filed yet. Then work one filing at a time: cat ./state/edition/editions/<edition-date>/filings/<id>/<rev>.json, judge it against WRITING.md (format, whether a reader would get the same understanding from the first paragraphs of the main source, named speakers, the reporting bar), and call mcp_newsroom_review_article for that one with this schedule occurrence as event_key before opening the next. Review a forecast as soon as it is filed; do not wait for its dissent. Rule on at most two filings per turn, then end the turn; complete only the inbox items for the filings you ruled on. Return PASS, REVISION_REQUEST, HOLD or SPIKE; a REVISION_REQUEST carries every defect in one message to the owner in room:filing, and a cut names the evidence row ([E6]) whose fact must go. You never rewrite a reporter's prose. After any PASS, do what the result's next says and tell the owner in room:filing the piece passed and whether its facts-check request was already sent. If the result says the composition prerequisites are ready, use moltnet_send on clank-newsroom to room:release mentioning @caslon with the edition date, article id and revision, and ask Caslon to read the fresh INDEX and compose. When the INDEX shows the passed-article floor met (the passed=n/N counter in the compose line) and there are no D ledger.settlements or D ledger.worlddesk rows yet, mention @ledger in room:release once; Ledger's own wake is only the scheduled fallback. Verify the send succeeded before completing the inbox item or ending the turn, and never repeat a handoff already sent."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: spike }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, tools: [review_article] }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:484748db3a8e990462b01e82cd7f265eba5c1152d7f055fe92b4de646c797e53, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:bf65a5ae523a7dc286d07ec5c9f90dd475f282249ef0dc00509d5ebbff3f6339, mount: ./repos/newsroom, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-spike/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
