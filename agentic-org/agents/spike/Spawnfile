spawnfile_version: "0.1"
kind: agent
name: spike
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      # Sized to FILINGS, not assignments. Spike is the only agent whose work
      # scales with everyone else's output: six reporters revising means every
      # filing and every revision passes through this one reviewer, and each
      # verdict costs a turn plus the handoff message the runbook requires.
      #
      # 2026-09-26 is the measurement: 6 stories produced 14 filings and 13
      # verdicts, which consumed roughly 30 turns at about 2.1 turns per filing.
      # With 40 as the ceiling and ~10 turns already destroyed by a Mneme ledger
      # crash, spike hit agent_execution_ceiling with three stories still
      # unreviewed and the edition died at passed=3/5 — not on editorial
      # judgement, which is the only thing that should stop a paper.
      #
      # 100 covers a heavy revision day (~20 filings at 2.5 turns) with headroom.
      # The organization-wide fuse still bounds total spend, so this widens one
      # agent's share rather than the blast radius.
      max_executions: 100
      max_tokens: 12000000
    turn_limits:
      max_tokens: 1100000
      timeout_ms: 900000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 15 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. It lists every assignment, filing and verdict on record today, and each F row already carries the mechanical checks you would otherwise re-derive by reading — word count, refs, distinct source domains, topic validity, and a lint field naming any citation that does not resolve, any reference out of evidence order, any persona left in the body. Those were computed from the filing itself at the moment it was written; take them as done and spend your reading on the judgement they cannot make. Then work one filing at a time: cat ./state/edition/editions/<edition-date>/filings/<id>/<rev>.json, decide, call mcp_newsroom_review_article for that one, and only then open the next. Never cat the whole filings directory in one go, and never re-read a filing you have already ruled on — the index is what tells you a revision landed. Use this schedule occurrence as event_key. Return PASS, REVISION_REQUEST, HOLD or SPIKE. A REVISION_REQUEST mentions the owning reporter in room:filing with actionable notes and goes back to them: you never rewrite a reporter's prose and never edit a reporter-owned file. After any PASS, read the current INDEX again. If the review result says the composition prerequisites are ready, use moltnet_send on clank-newsroom to room:release mentioning @caslon with the edition date, article id and revision; ask Caslon to read the fresh INDEX and compose from accepted inputs. Verify the send succeeded before completing the inbox item or ending the turn, and do not repeat a handoff already sent for that accepted revision. When its header shows the passed-article floor met or exceeded (the passed=n/N counter in the compose line) and there are no D ledger.settlements or D ledger.worlddesk rows yet, mention @ledger in room:release once and say the paper has enough passed copy for the desk documents. Do not wait for the 15:30 schedule to make that handoff; the schedule is only the fallback if review finishes quietly. An index with no F rows, or no index at all, means nothing has been filed yet and is not an error to investigate."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: spike }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/spike/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: spike, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/spike/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/spike/tools/newsroom/state/transaction.mjs, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:spike" }
      tools: [review_article]
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:f893ed6f3353a26de641cee05374f5a387a55c98915a880eaa5a0e543d7290d2, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:9408c63f9eb01b59d376610e5502e23afa658983a64ad077f5521914e3d2d3ed, mount: ./repos/newsroom, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-spike/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
