spawnfile_version: "0.1"
kind: agent
name: spike
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 14 * * *"
  timezone: Europe/Berlin
  prompt: "Your working directory is your agent root. Filed articles for today are under ./state/edition/editions/<edition-date>/filings/ and ./state/edition/editions/<edition-date>/articles/ — read them by path. Call mcp_newsroom_review_article for each, using this schedule occurrence as event_key. Return PASS, REVISION_REQUEST, HOLD or SPIKE. A REVISION_REQUEST mentions the owning reporter in room:filing with actionable notes and goes back to them: you never rewrite a reporter's prose and never edit a reporter-owned file. An empty or missing directory means nothing has been filed yet and is not an error to investigate."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: spike }
      rooms:
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/spike/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: spike, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/spike/state/edition }
      tools: [review_article]
workspace:
  docs: { system: AGENTS.md }
  skills:
    - { ref: ../../skills/editorial-review }
    - { ref: ../../skills/repository-ownership }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:5a8bc0c125f4be8345965bc055245966491458b60b66e7f217a1884b1f0094fb, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:34ab69f623f4592d3d33fe2e57dfc4e109a75f72bcb2c1c2e57f9838b76fab64, mount: ./repos/newsroom-private, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-spike/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
