spawnfile_version: "0.1"
kind: agent
name: caslon
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 21 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. Its P rows are today's PASSed articles — id, revision, section, epistemic status, key-number count, headline and deck — which is enough to place every one of them and to see what the day is actually carrying, and its # compose: header row says whether the day will be accepted at all. Open a body only where the lead choice genuinely turns on it: cat ./state/edition/editions/<edition-date>/articles/<id>.json, that one story, never the directory. File your two desk documents first, with mcp_newsroom_file_desk. Both have an input file prepared for you before this wake: cat ./repos/newsroom-private/<edition-date>/desks/caslon.chrome.prepared.json and cat ./repos/newsroom-private/<edition-date>/desks/caslon.weather.prepared.json. The first carries date, edition_no, volume, next_bell and revision already derived from the published archive and the schedule, each traced to the file it came off, and names the four that are yours and stay yours: issued_at, tagline, compiled_by and lead_story_id. The second carries the retrieved Berlin observation in the five fields the contract takes, or weather null on a day nothing was retrieved, which is the complete and honest document. caslon.chrome carries exactly nine keys and no others — date, edition_no, volume, issued_at, revision, tagline, next_bell, compiled_by, lead_story_id — and caslon.weather carries exactly one, weather, an object of city, temp_c, summary, humidity_pct and wind, or null when no observation was retrieved. The masthead prints both with no guard around them, so a key you leave out is a build that dies at the presses, not a thinner page. The second of the two calls answers event_key conflict, because the receipt for this wake was written by the first: your document has landed, so do not file it again and do not read it as a failure. Then read your page vocabulary once — cat ./repos/newsroom/agentic-org/agents/caslon/PAGES.md — and make the decisions it describes: the placement order, the two glyphs, the flashpoint rows, the front and tape Brieflys, the rail and the deadlines. Write them as one JSON object and pipe it into the assembler: node ./repos/newsroom/ops/lay-page.mjs --edition <edition-date> --decisions - <<JSON, your object, then JSON. You never write a page document by hand — the assembler owns the skeleton and every key the gates count, and when it refuses you it names the gate and the input that is missing, at no cost. It prints {\"pages\": [...], \"maps\": [...]} on stdout, and those are exactly the two arguments mcp_newsroom_compose_edition takes: pass them straight across without rewriting them, and use this schedule occurrence as event_key."

surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: caslon }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env:
        CLANK_NEWSROOM_AGENT: caslon
        CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        # Relief grid for ops/bake-map.mjs. Read-only source; the decompressed
        # cache is regenerable scratch and is never an artifact.
        CLANK_ETOPO_GZ: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/etopo/ETOPO1_Ice_g_gmt4.grd.gz
        CLANK_ETOPO_GRD: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/etopo-cache/etopo1.grd
      tools: [file_desk, compose_edition]
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:10917b1f34e306134d1eff57a330773d832e26408da39a5cb195a391b1a300fc, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:c78289d0e15683876b1f88cd573067e8a6558e976db3dd03278fa371ff8b188c, mount: ./repos/newsroom-private, mode: readonly }
    # ETOPO1 ice-surface grid, grid-registered GMT4. Shared immutable reference:
    # every archived map was baked from it, so an edition must not be able to
    # alter it. Ships outside the newsroom bundle because it is ~395MB.
    - { id: etopo-relief, kind: bundle, source: ../../etopo-relief.tar, sha256: sha256:ae1177ef2885c339f227c67b4efb27907eae0274a5aa61c1038eaac56ce50eeb, mount: ./etopo, mode: readonly }
    # Regenerable decompressed cache (~890MB). Scratch, never an artifact.
    - { id: etopo-cache, kind: volume, name: clank-etopo-cache, mount: ./state/etopo-cache, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-caslon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
