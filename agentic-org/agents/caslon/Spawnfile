spawnfile_version: "0.1"
kind: agent
name: caslon
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 40
      max_tokens: 10000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0,45 16 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 300
  prompt: "Start at ./state/edition/editions/<edition-date>/INDEX. This wake fires at 16:00 to compose and again at 16:45 as the retry: if the edition is already composed, end the turn. Read repos/newsroom/agentic-org/agents/caslon/RUNBOOK.md and repos/newsroom/agentic-org/agents/caslon/PAGES.md. File both prepared desk documents with file_desk using the current wake id; both must succeed. Select catalogue art or bake it as needed, including decisions.art[order[0]] lead art when the lead lacks reporter art; generated lead maps need locator_context. The lead is an analysis when one has passed. Author the decision record and call art lay_pages, then compose_edition with the returned layout_sha256. If compose_edition refuses with a facts check missing, send ONE room:filing message mentioning each owner it names with the edition and article id, asking them to record_freshness_check now (outcome unavailable if their research answer has not arrived), and end the turn. On the 16:45 wake, try to compose; if the INDEX is blocked or compose_edition refuses for anything you do not own, including a missing facts check, do not ask the owners again: send @brass one message in room:release listing each missing item and its owner, and end the turn. After a successful compose, mention @pressman in room:release with the composition. Correct only your own artifacts; request reporter changes from their owner."

surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: caslon }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      env:
        CLANK_ETOPO_GZ: "${workspace}/etopo/ETOPO1_Ice_g_gmt4.grd.gz"
        CLANK_ETOPO_GRD: "${workspace}/state/etopo-cache/etopo1.grd"
      tools: [file_desk, compose_edition]
    - { name: art }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: art-cache, kind: volume, name: clank-art-cache, mount: ./state/art-cache, mode: mutable, sharing: per_agent }
    - { id: etopo-relief, kind: bundle, source: ../../etopo-relief.tar, mount: ./etopo, mode: readonly }
    - { id: etopo-cache, kind: volume, name: clank-etopo-cache, mount: ./state/etopo-cache, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-caslon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
