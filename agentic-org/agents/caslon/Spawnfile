spawnfile_version: "0.1"
kind: agent
name: caslon
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 15 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. Its P rows are today's PASSed articles — id, revision, section, epistemic status, key-number count, headline and deck — which is enough to place every one of them and to see what the day is actually carrying. Open a body only where the lead choice genuinely turns on it: cat ./state/edition/editions/<edition-date>/articles/<id>.json, that one story, never the directory. Decide the visual layer only: which stories go on front and which on tape, which story leads, the map bounds each story needs, and the illustration rhythm. Then call mcp_newsroom_file_desk for caslon.chrome and caslon.weather and mcp_newsroom_compose_edition with exactly front and tape, using this schedule occurrence as event_key. Baking and assembly are scripts; you make the choices, not the bytes."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: caslon }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env:
        CLANK_NEWSROOM_AGENT: caslon
        CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        # Relief grid for ops/bake-map.mjs. Read-only source; the decompressed
        # cache is regenerable scratch and is never an artifact.
        CLANK_ETOPO_GZ: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/etopo/ETOPO1_Ice_g_gmt4.grd.gz
        CLANK_ETOPO_GRD: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/etopo-cache/etopo1.grd
        # The 2026-09-05 edition shipped without a forecast piece. The publisher
        # took that call deliberately; nothing upstream asks a reporter to file
        # a forecast, so no ordinary day meets the floor on its own.
        #
        # The value is the edition it waives, never a boolean: this line stops
        # having any effect the moment the paper moves past 2026-09-05, and the
        # composed artifact and edition INDEX both record that the paper went
        # out under it. Change the date only with the same decision behind it;
        # deleting the line restores the floor immediately.
        CLANK_EDITION_DIVERSITY_WAIVER: "2026-09-05"
      tools: [file_desk, compose_edition]
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:5e061df518161c2bc51037898f2d9ec1c3586f8a4745098ed3e4a2fc47a1627e, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:aea46e3296ca466bd419d3f73d54ff63f61096e854940653d609956393d04b8e, mount: ./repos/newsroom-private, mode: readonly }
    # ETOPO1 ice-surface grid, grid-registered GMT4. Shared immutable reference:
    # every archived map was baked from it, so an edition must not be able to
    # alter it. Ships outside the newsroom bundle because it is ~395MB.
    - { id: etopo-relief, kind: bundle, source: ../../etopo-relief.tar, sha256: sha256:ae1177ef2885c339f227c67b4efb27907eae0274a5aa61c1038eaac56ce50eeb, mount: ./etopo, mode: readonly }
    # Regenerable decompressed cache (~890MB). Scratch, never an artifact.
    - { id: etopo-cache, kind: volume, name: clank-etopo-cache, mount: ./state/etopo-cache, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-caslon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
