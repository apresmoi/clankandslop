spawnfile_version: "0.1"
kind: agent
name: caslon
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 40
      max_tokens: 10000000
    turn_limits:
      max_tokens: 2500000
      # THIRTY MINUTES, not fifteen. Caslon's turn is the longest in the
      # newsroom by construction: lay_pages selects or bakes every map and glyph,
      # assembles both page documents, and compose_edition then re-runs the
      # canonical assembler and verifies the result against the baked structure.
      #
      # 2026-09-26 is the measurement, three times over. Caslon was killed at the
      # 900,000 ms limit with the receipt reading
      #   limit_exceeded; limit=timeout; mcp=16/17 answered
      # -- ONE tool call short of finishing, on an edition whose compose gate was
      # satisfied and whose four articles had all passed review. The paper existed
      # and a fifteen-minute turn was the only thing that stopped it shipping.
      #
      # Requests and tokens are NOT raised: 16 of 48 requests is nowhere near the
      # cap, so raising them would be speculative rather than measured.
      #
      # The manifest bound on timeoutMs is 3,600,000 ms, so this is expressible
      # without any contract or manifest change. It is still a bound, not an
      # absence of one: a compositor that hangs is failed at 30 minutes.
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "0 16 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Start at ./state/edition/editions/<edition-date>/INDEX and read repos/newsroom/agentic-org/agents/caslon/RUNBOOK.md plus repos/newsroom/agentic-org/agents/caslon/PAGES.md. File both prepared desk documents with file_desk using the current wake id; both must succeed. Select catalogue art or bake it as needed, including decisions.art[order[0]] lead art when the lead lacks reporter art; generated lead maps need locator_context. Author the decision record and call art lay_pages, then compose_edition with the returned layout_sha256. Every P row needs its owner's facts check (a K row) first: if compose_edition refuses with facts check missing, send ONE room:filing message mentioning each owner it names with the edition and article id, asking them to record_freshness_check now (outcome unavailable if their research answer has not arrived), and end the turn; the owner who records the last check mentions you again. The tools enforce the baked page structure. Mention @pressman in room:release with the composition. Correct only your own artifacts; request reporter changes from their owner."

surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: caslon }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env:
        CLANK_NEWSROOM_AGENT: caslon
        CLANK_PUBLIC_CONTENT_VOLUME: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom-content
        CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/tools/newsroom/state/transaction.mjs
        # No CLANK_PRIVATE_SOURCE_ROOT, deliberately. Neither of Caslon's two
        # newsroom tools reads the research corpus volume: compose_edition takes
        # the corpus identity from the edition's own assignment records, which is
        # the whole point — the volume can have been swapped under the org since
        # the lineup was commissioned, so re-reading the mount at 16:00 would
        # publish a provenance claim the stories do not rest on. file_desk here
        # only carries caslon.chrome and caslon.weather, which read nothing from
        # the mount either (ledger.worlddesk is Ledger's, and Ledger declares it).
        # A mount declared for an agent no tool refuses without reads as an
        # enforced guarantee and is not one, so validate-org.mjs refuses it.
        CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700
        CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token
        CLANK_DAIMON_AGENT_ID: "agent:caslon"
        # Relief grid for ops/bake-map.mjs. Read-only source; the decompressed
        # cache is regenerable scratch and is never an artifact.
        CLANK_ETOPO_GZ: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/etopo/ETOPO1_Ice_g_gmt4.grd.gz
        CLANK_ETOPO_GRD: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/etopo-cache/etopo1.grd
      tools: [file_desk, compose_edition]
    - name: art
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/tools/newsroom/art/server.mjs]
      env:
        CLANK_NEWSROOM_AGENT: caslon
        CLANK_PUBLIC_CONTENT_VOLUME: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom-content
        CLANK_PUBLIC_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom
        CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        CLANK_NEWSROOM_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/tools/newsroom/state/transaction.mjs
        CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700
        CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token
        CLANK_DAIMON_AGENT_ID: "agent:caslon"
        CLANK_ART_OUTPUT_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/art-cache
        CLANK_ETOPO_GZ: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/etopo/ETOPO1_Ice_g_gmt4.grd.gz
        CLANK_ETOPO_GRD: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/etopo-cache/etopo1.grd
      tools: [list_art_catalogue, bake_map, bake_glyph, inspect_artifact, inspect_catalogue_preview, lay_pages]
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: art-cache, kind: volume, name: clank-art-cache, mount: ./state/art-cache, mode: mutable, sharing: per_agent }
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:484748db3a8e990462b01e82cd7f265eba5c1152d7f055fe92b4de646c797e53, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:e73c6eca6323a8eabb05e784709222c3fa8be3b5d71842d1746ab15c108a5ff1, mount: ./repos/newsroom, mode: readonly }
    # ETOPO1 ice-surface grid, grid-registered GMT4. Shared immutable reference:
    # every archived map was baked from it, so an edition must not be able to
    # alter it. Ships outside the newsroom bundle because it is ~395MB.
    - { id: etopo-relief, kind: bundle, source: ../../etopo-relief.tar, sha256: sha256:ae1177ef2885c339f227c67b4efb27907eae0274a5aa61c1038eaac56ce50eeb, mount: ./etopo, mode: readonly }
    # Regenerable decompressed cache (~890MB). Scratch, never an artifact.
    - { id: etopo-cache, kind: volume, name: clank-etopo-cache, mount: ./state/etopo-cache, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-caslon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
