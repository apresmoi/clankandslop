spawnfile_version: "0.1"
kind: agent
name: caslon
runtime:
  name: daimon
  options:
    engine: codex
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 17 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. Start with one call: cat ./state/edition/editions/<edition-date>/INDEX. Its P rows are today's PASSed articles — id, revision, section, epistemic status, key-number count, headline and deck — which is enough to place every one of them and to see what the day is actually carrying. Open a body only where the lead choice genuinely turns on it: cat ./state/edition/editions/<edition-date>/articles/<id>.json, that one story, never the directory. File your two desk documents first, with mcp_newsroom_file_desk. caslon.chrome carries exactly nine keys and no others — date, edition_no, volume, issued_at, revision, tagline, next_bell, compiled_by, lead_story_id — and caslon.weather carries exactly one, weather, an object of city, temp_c, summary, humidity_pct and wind. The masthead prints both with no guard around them, so a key you leave out is a build that dies at the presses, not a thinner page. The second of the two calls answers event_key conflict, because the receipt for this wake was written by the first: your document has landed, so do not file it again and do not read it as a failure. Then write the two pages yourself and hand them to mcp_newsroom_compose_edition as exactly front and tape. A page is a JSON document with edition, page, paper, title, active, head and flow, and every entry in head and flow is {\"block\": \"<Name>\", \"props\": {...}} — the key is block, never type, and every parameter nests under props. Nothing assembles those pages for you: compose_edition validates the documents you wrote and refuses them whole. The block vocabulary, the front and tape skeletons, the illustration rules and what compose_edition checks are all in your own instructions — follow them, and use this schedule occurrence as event_key."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: caslon }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env:
        CLANK_NEWSROOM_AGENT: caslon
        CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/edition
        # Relief grid for ops/bake-map.mjs. Read-only source; the decompressed
        # cache is regenerable scratch and is never an artifact.
        CLANK_ETOPO_GZ: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/etopo/ETOPO1_Ice_g_gmt4.grd.gz
        CLANK_ETOPO_GRD: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/caslon/state/etopo-cache/etopo1.grd
        # Nothing upstream asks a reporter to file a forecast, so no ordinary
        # day meets the diversity floor on its own; the publisher waives it
        # one edition at a time, deliberately.
        #
        # The value is the edition it waives, never a boolean: this line stops
        # having any effect the moment the paper moves past the named edition,
        # and the composed artifact and edition INDEX both record that the
        # paper went out under it. All crons in policies/schedule.json fire
        # daily (Europe/Berlin), so the edition composed on any given calendar
        # day is dated that same day — re-date this alongside every edition
        # that ships without a forecast piece, on the day it ships. Currently
        # waiving 2026-09-07 (tomorrow's unattended run: Ledger and Pressman
        # were only just wired to wake at all, so there is no dated forecast
        # with a named dissent on record yet). Change the date only with the
        # same decision behind it; deleting the line restores the floor
        # immediately.
        CLANK_EDITION_DIVERSITY_WAIVER: "2026-09-06"
      tools: [file_desk, compose_edition]
workspace:
  docs: { system: AGENTS.md }
  resources:
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:a64a64900b76e2314a5094a16004898594601a795a1434cf56f8abb6eafdae27, mount: ./repos/newsroom, mode: readonly }
    - { id: private-archive, kind: bundle, source: ../../newsroom-private.tar, sha256: sha256:de3cb8bceb781f6f45bc8a6762cbc4b6a50fcf1e9e6fb384fa33a549499f4010, mount: ./repos/newsroom-private, mode: readonly }
    # ETOPO1 ice-surface grid, grid-registered GMT4. Shared immutable reference:
    # every archived map was baked from it, so an edition must not be able to
    # alter it. Ships outside the newsroom bundle because it is ~395MB.
    - { id: etopo-relief, kind: bundle, source: ../../etopo-relief.tar, sha256: sha256:ae1177ef2885c339f227c67b4efb27907eae0274a5aa61c1038eaac56ce50eeb, mount: ./etopo, mode: readonly }
    # Regenerable decompressed cache (~890MB). Scratch, never an artifact.
    - { id: etopo-cache, kind: volume, name: clank-etopo-cache, mount: ./state/etopo-cache, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-caslon/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
