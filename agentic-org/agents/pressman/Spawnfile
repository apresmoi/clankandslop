spawnfile_version: "0.1"
kind: agent
name: pressman
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 60
      max_tokens: 4000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: medium
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 16 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Start at ./state/edition/editions/<edition-date>/INDEX and read repos/newsroom/agentic-org/agents/pressman/RUNBOOK.md. If the current composition is ready, call prepare_release using the current wake id. Follow its bounded job polling until complete, then call stage_release for that exact composition. Mechanical content, layout and build checks are the release gate. Report failures to the owning colleague; never edit content or bypass a gate. Produce only a local staging artifact and receipt; the host job publishes. If nothing is composed yet, end the turn: Caslon mentions you when it composes."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: pressman }
      rooms:
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      env:
        CLANK_PUBLIC_SOURCE_ROOT: "${workspace}/repos/newsroom"
        CLANK_WEBSITE_DEPS_ROOTS: "${workspace}/deps"
        CLANK_PUBLIC_ASSET_ROOTS: "${workspace}/assets"
        CLANK_RELEASE_STAGING_ROOT: "${workspace}/staging"
        CLANK_NEWSROOM_RELEASE_ADAPTER: "${workspace}/tools/private/current/newsroom/build/release.mjs"
        CLANK_PRIVATE_SOURCE_ROOT: "${workspace}/repos/newsroom-private"
      tools: [stage_release]
    - { name: visual }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - id: website-deps
      kind: bundle
      build:
        generated:
          command: [node, agentic-org/bundles/website-deps.mjs, "node:24-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df", "${output}"]
          cwd: ../../..
          image: "node:24-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df"
          inputs:
            - { root: ../../../website, exclude: [astro.config.mjs, public, scripts, src, tsconfig.json] }
            - { root: ../../bundles, exclude: [CLAUDE.md, AGENTS.md] }
          timeout_seconds: 1200
      mount: ./deps
      mode: readonly
    - id: public-assets
      kind: bundle
      build:
        files:
          root: ../../../website/public/og
      mount: ./assets/website/public/og
      mode: readonly
    - { id: public-content, kind: volume, name: clank-release-staging, mount: ./staging, mode: mutable, sharing: per_agent }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-pressman/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
