spawnfile_version: "0.1"
kind: agent
name: brass
runtime:
  name: daimon
  options:
    engine: codex
    codex_policy: workspace-no-network
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 60
      max_tokens: 8000000
execution:
  model:
    primary:
      provider: openai
      name: gpt-5.6-terra
      auth:
        method: codex
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 12 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. This is conference. Make three bounded reads before you decide, and nothing past them (memory_search is not a read): cat ./state/edition/editions/<edition-date>/INDEX for existing assignments, C-row lead decisions and the # compose: floor line; moltnet_read with network clank-newsroom and target room:conference for the reporters' pitches; cat ./repos/newsroom-private/current/<edition-date>/desks/_all.index for the slate, which shows the story the day needs that nobody pitched. Search your memory for stories you told someone to bring back and for pitches you held; when one comes back ripe, weigh it with the rest. Never open a desk file or story file. Keep accepted assignments unless something substantive changed. Rank stories by significance, not by how easy they are to source: an important story with an unknown in it is still a story. Commission six where the day gives six worth running; record_assignment refuses fewer than five, and on a thin day say plainly that the fifth is a short brief. The Hearth is usually the sixth: when Vesta pitches a real pattern, run it. The Hearth is always an ANALYSIS whose proposition is Vesta's reading of the pattern, never a BRIEF, and it does not count toward the one or two analyses. Open each assignment brief with its format: ANALYSIS with a one-line proposition (what the reader will understand that the main source does not say), or BRIEF. The piece you expect to lead and the forecast, when there is one, are analyses; commission one or two analyses and make the rest briefs. Give the angle and the evidence to carry, never a length. Commission a forecast only when the evidence can carry a probability, a base rate or a dated schedule someone can check, and never more than one: mark that assignment slot: \"forecast\" and name its dissenter, a different desk. A day with no call worth making runs without one; never commission a forecast to fill a slot. Kill the weak pitches by name and say why. A good pitch that is early is not a kill: say not today, tell its owner roughly when to bring it back, and save that with memory_register; when two reporters pitch one story, say whose it is. Record the outcome with mcp_newsroom_record_assignment using this schedule occurrence as event_key. Only a successful response permits commission handoffs; if the tool refuses or errors, report the service problem without mentioning reporters and end the turn. If it accepts, summarize the lineup in room:conference with plain names, then mention each assigned reporter once in room:assignment as @<id> with the story, its format line and the evidence to carry, and, on a day with a forecast, tell its owner to mention the dissenter in room:filing when filing. Then send one separate room:conference message mentioning each reporter with no assignment today as @<id>: the lineup is up, and if they know something useful about a colleague's story, now is the time to say it. You pick and you kill; you never write prose, research a story yourself, or overrule Spike."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: brass }
      dms: { enabled: true, wake: all, allowed_wake_senders: [ops] }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - { name: newsroom, env: { CLANK_PRIVATE_SOURCE_ROOT: "${workspace}/repos/newsroom-private" }, tools: [record_assignment, amend_assignment, record_freshness_check] }
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-brass/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
