spawnfile_version: "0.1"
kind: agent
name: brass
runtime:
  name: daimon
  options:
    engine: grok
    attention:
      max_batch_messages: 8
      max_batch_bytes: 12000
      max_executions: 60
      max_tokens: 8000000
    turn_limits:
      max_tokens: 2500000
      timeout_ms: 1800000
      max_requests: 48
execution:
  model:
    primary:
      provider: xai
      name: grok-4.6
      auth:
        method: grok
      reasoning_effort: high
  sandbox:
    mode: workspace
schedule:
  kind: cron
  cron: "30 12 * * *"
  timezone: Europe/Berlin
  jitter_seconds: 900
  prompt: "Your working directory is your agent root. This is conference. Make three bounded reads before you decide, and nothing past them: cat ./state/edition/editions/<edition-date>/INDEX for existing assignments, C-row lead decisions and the # compose: floor line; moltnet_read with network clank-newsroom and target room:conference for the reporters' pitches; cat ./repos/newsroom-private/<edition-date>/desks/_all.index for the slate, which shows the story the day needs that nobody pitched. Never open a desk file or story file. Keep accepted assignments unless something substantive changed. Rank stories by significance, not by how easy they are to source: an important story with an unknown in it is still a story. Commission six where the day gives six worth running; record_assignment refuses fewer than five, and on a thin day say plainly that the fifth is a short brief. The Hearth is usually the sixth: when Vesta pitches a real pattern, run it. Open each assignment brief with its format: ANALYSIS with a one-line proposition (what the reader will understand that the main source does not say), or BRIEF. The piece you expect to lead and the day's forecast are analyses; commission one or two analyses and make the rest briefs. Give the angle and the evidence to carry, never a length. One assignment is the day's forecast: mark exactly that assignment slot: \"forecast\" and name its dissenter, a different desk. Kill the weak pitches by name and say why; when two reporters pitch one story, say whose it is. Record the outcome with mcp_newsroom_record_assignment using this schedule occurrence as event_key. Only a successful response permits commission handoffs; if the tool refuses or errors, report the service problem without mentioning reporters and end the turn. If it accepts, summarize the lineup in room:conference with plain names, then mention each assigned reporter once in room:assignment as @<id> with the story, its format line and the evidence to carry, and tell the forecast owner to mention the dissenter in room:filing when filing. You pick and you kill; you never write prose, research a story yourself, or overrule Spike."
surfaces:
  moltnet:
    - network: clank-newsroom
      auth: { token_id: brass }
      rooms:
        conference: { wake: mentions }
        assignment: { wake: mentions }
        filing: { wake: mentions }
        sensor: { wake: mentions }
        research: { wake: mentions }
        release: { wake: mentions }
environment:
  mcp_servers:
    - name: newsroom
      transport: stdio
      command: /usr/local/bin/node
      args: [/var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/brass/repos/newsroom/agentic-org/scripts/production-newsroom-mcp.mjs]
      env: { CLANK_NEWSROOM_AGENT: brass, CLANK_PUBLIC_CONTENT_VOLUME: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/brass/repos/newsroom-content, CLANK_EDITION_STATE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/brass/state/edition, CLANK_NEWSROOM_STATE_ADAPTER: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/brass/tools/newsroom/state/transaction.mjs, CLANK_PRIVATE_SOURCE_ROOT: /var/lib/spawnfile/instances/daimon/daimon-organization/workspace/agents/brass/repos/newsroom-private, CLANK_DAIMON_CONTROL_URL: http://127.0.0.1:19700, CLANK_DAIMON_CONTROL_TOKEN_FILE: /run/clank-newsroom-control/token, CLANK_DAIMON_AGENT_ID: "agent:brass" }
      tools: [record_assignment, record_freshness_check]
workspace:
  docs: { system: AGENTS.md, soul: SOUL.md }
  resources:
    - { id: newsroom-tools, kind: bundle, source: ../../newsroom-tools.tar, sha256: sha256:484748db3a8e990462b01e82cd7f265eba5c1152d7f055fe92b4de646c797e53, mount: ./tools/newsroom, mode: readonly }
    - { id: public-content, kind: bundle, source: ../../newsroom-runtime.tar, sha256: sha256:7683693d1ec07f91b8399dafcd677a3d4e45473684d6e4b98724fb715fb5195f, mount: ./repos/newsroom, mode: readonly }

memory:
  - id: self
    store:
      kind: sqlite
      path: /var/lib/spawnfile/memory/clank-brass/self.sqlite
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: false
