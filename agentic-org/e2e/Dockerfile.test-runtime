FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436
ARG DAIMON_SOURCE_SHA256
ARG DAIMON_MANIFEST_SHA256
COPY daimon-test-runtime /opt/noopolis/daimon-test/dist
COPY daimon-node-modules /opt/noopolis/daimon-test/node_modules
LABEL org.noopolis.e2e-only="true" \
      org.noopolis.daimon-source-sha256="${DAIMON_SOURCE_SHA256}" \
      org.noopolis.daimon-manifest-sha256="${DAIMON_MANIFEST_SHA256}"
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/node", "/opt/noopolis/daimon-test/dist/runtime/testRuntimeSubprocess.js"]
